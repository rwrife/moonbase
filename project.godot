; Engine configuration file.
config_version=5

[application]
config/name="Selene Frontier"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[input]
pan_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
pan_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
pan_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
pan_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
rotate_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
rotate_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
speed_one={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
speed_two={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
speed_four={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":51)]
}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.018, 0.026, 0.05, 1)
